# IQAir AirVisual API key (server-only; never prefix with NEXT_PUBLIC_).
# Get a free Community key at https://www.iqair.com/dashboard/api
IQAIR_API_KEY=

# Firebase service-account key (server-only; never prefix with NEXT_PUBLIC_):
# the downloaded JSON file's contents on one line. Firebase console → Project
# settings → Service accounts. Leave empty locally to use
# `gcloud auth application-default login`.
FIREBASE_SERVICE_ACCOUNT=

# Public origin, used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the "Write to us" button sends email. Defaults to the
# project's communications lead.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: CARTO basemap key. Public by nature (it is sent with every tile
# request); defaults to the project's key when unset.
NEXT_PUBLIC_CARTO_API_KEY=

# Development only: set to "sample" to use made-up, clearly labelled readings
# instead of spending API quota. Ignored in production builds.
# UT_DATA_SOURCE=sample
